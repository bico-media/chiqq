{
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 100,
		"bracketSpacing": false
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "es5",
			"arrowParentheses": "asNeeded"
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab",
			"trailingCommas": "none"
		}
	},
	"linter": {
		"enabled": false
	},
	"files": {
		"includes": ["{.,src,test}/**/*.{ts,js,json,md}"]
	}
}
